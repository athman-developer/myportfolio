= 0f;
        private float qiblah = 0f;
        private boolean hasQ = false;
        private boolean isLocked = false;
        private float strength = 1f;
        private boolean first = true;
        private float pulse = 0f;

        CompassView(Context c) { super(c); p.setStrokeCap(Paint.Cap.ROUND); setLayerType(LAYER_TYPE_SOFTWARE, null); }

        void setData(float heading, float q, boolean has, float horizontal, boolean lockedNow) {
            targetHeading = normalize(heading); qiblah = q; hasQ = has; strength = horizontal; isLocked = lockedNow;
            if (first) { displayHeading = targetHeading; first = false; }
            postInvalidateOnAnimation();
        }

        void resetAnimation() { first = true; invalidate(); }

        @Override protected void onDraw(Canvas c) {
            super.onDraw(c);
            displayHeading = normalize(displayHeading + angleDiff(targetHeading, displayHeading) * .16f);
            pulse += .055f;
            if (pulse > Math.PI * 2) pulse = 0f;

            float w = getWidth(), h = getHeight();
            c.drawColor(CREAM);
            p.setStyle(Paint.Style.FILL);
            p.setTextAlign(Paint.Align.CENTER);
            p.setTypeface(Typeface.DEFAULT_BOLD);
            p.setColor(INK);
            p.setTextSize(spPx(13));
            c.drawText("PHONE HEADING", w/2, dp(34), p);
            p.setTextSize(Math.min(w*.105f, spPx(46)));
            c.drawText(Math.round(displayHeading) + "°  " + cardinal(displayHeading), w/2, dp(82), p);

            float cx = w/2f;
            float cy = Math.min(h*.48f, dp(330));
            float r = Math.min(w*.405f, dp(170));

            p.setColor(Color.WHITE);
            p.setShadowLayer(dp(12), 0, dp(5), Color.argb(25,0,0,0));
            c.drawCircle(cx, cy, r+dp(10), p);
            p.clearShadowLayer();

            p.setStyle(Paint.Style.STROKE);
            p.setStrokeWidth(dp(isLocked ? 7 : 4));
            p.setColor(isLocked ? GREEN : ORANGE);
            c.drawCircle(cx, cy, r, p);
            if (isLocked) {
                p.setStrokeWidth(dp(2));
                p.setColor(Color.argb((int)(70 + 45*Math.sin(pulse)), 15,138,95));
                c.drawCircle(cx, cy, r+dp(12)+(float)(dp(4)*Math.sin(pulse)), p);
            }

            c.save();
            c.rotate(-displayHeading, cx, cy);
            for (int deg=0; deg<360; deg+=5) {
                double a = Math.toRadians(deg-90);
                float ro = r*.92f;
                float ri = r*(deg%30==0 ? .80f : deg%10==0 ? .84f : .875f);
                p.setStrokeWidth(dp(deg%30==0 ? 2.2f : 1f));
                p.setColor(deg%30==0 ? INK : Color.rgb(180,180,180));
                c.drawLine(cx+(float)Math.cos(a)*ri, cy+(float)Math.sin(a)*ri,
                        cx+(float)Math.cos(a)*ro, cy+(float)Math.sin(a)*ro,p);
            }
            String[] labels={"N","E","S","W"};
            for(int i=0;i<4;i++){
                double a=Math.toRadians(i*90-90);
                p.setStyle(Paint.Style.FILL); p.setTypeface(Typeface.DEFAULT_BOLD); p.setTextSize(spPx(18));
                p.setColor(i==0?ORANGE:INK);
                c.drawText(labels[i],cx+(float)Math.cos(a)*r*.69f,cy+(float)Math.sin(a)*r*.69f+spPx(6),p);
            }
            c.restore();

            if (hasQ) {
                float relative = angleDiff(qiblah, displayHeading);
                c.save(); c.rotate(relative, cx, cy);
                p.setStyle(Paint.Style.FILL); p.setColor(isLocked ? GREEN : ORANGE);
                Path arrow = new Path();
                arrow.moveTo(cx, cy-r*.82f);
                arrow.lineTo(cx-dp(14), cy-r*.58f);
                arrow.lineTo(cx-dp(5), cy-r*.61f);
                arrow.lineTo(cx-dp(5), cy-dp(18));
                arrow.lineTo(cx+dp(5), cy-dp(18));
                arrow.lineTo(cx+dp(5), cy-r*.61f);
                arrow.lineTo(cx+dp(14), cy-r*.58f);
                arrow.close(); c.drawPath(arrow,p);
                p.setColor(INK); c.drawRoundRect(cx-dp(18),cy-r*.50f,cx+dp(18),cy-r*.36f,dp(4),dp(4),p);
                p.setColor(ORANGE); c.drawRect(cx-dp(18),cy-r*.445f,cx+dp(18),cy-r*.425f,p);
                c.restore();

                p.setStyle(Paint.Style.FILL); p.setColor(INK);
                Path top = new Path(); top.moveTo(cx,cy-r-dp(18)); top.lineTo(cx-dp(10),cy-r-dp(2)); top.lineTo(cx+dp(10),cy-r-dp(2)); top.close(); c.drawPath(top,p);

                float diff = angleDiff(qiblah, displayHeading);
                float abs = Math.abs(diff);
                String guidance = isLocked ? "QIBLAH LOCKED" : abs < 4 ? "Hold steady…" : "Turn " + Math.round(abs) + "° " + (diff > 0 ? "right" : "left");
                p.setTextAlign(Paint.Align.CENTER); p.setTypeface(Typeface.DEFAULT_BOLD); p.setTextSize(spPx(19)); p.setColor(isLocked?GREEN:INK);
                c.drawText(guidance,w/2,cy+r+dp(55),p);
                p.setTypeface(Typeface.DEFAULT); p.setTextSize(spPx(14)); p.setColor(MUTED);
                c.drawText("Qiblah " + Math.round(qiblah) + "°  •  True north corrected", w/2, cy+r+dp(82), p);
            } else {
                p.setTextAlign(Paint.Align.CENTER); p.setTypeface(Typeface.DEFAULT_BOLD); p.setTextSize(spPx(16)); p.setColor(INK);
                c.drawText("Waiting for location…",w/2,cy+r+dp(58),p);
                p.setTypeface(Typeface.DEFAULT); p.setTextSize(spPx(13)); p.setColor(MUTED);
                c.drawText("Allow location so TREWX can calculate the Qiblah bearing.",w/2,cy+r+dp(82),p);
            }

            p.setTextAlign(Paint.Align.CENTER); p.setTypeface(Typeface.DEFAULT); p.setTextSize(spPx(12)); p.setColor(MUTED);
            String posture = strength < .35f ? "Tilt the phone flatter for a reliable compass heading." : "Keep the top edge of the phone aimed in the direction you are facing.";
            c.drawText(posture,w/2,h-dp(20),p);

            if (Math.abs(angleDiff(targetHeading, displayHeading)) > .06f || isLocked) postInvalid